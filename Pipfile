[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
# floor, not a pin: scaled_dot_product_attention gained enable_gqa in 2.5, and
# CausalSelfAttention depends on it. Anything from 2.5 up works, which means the
# stock torch on a rented image is usually fine - preflight.py proves it functionally.
torch = ">=2.5"
numpy = "*"
tiktoken = "*"
# fineweb.py: streams + tokenizes the training shards
datasets = "*"
tqdm = "*"
# hellaswag.py: reads the eval set, which ships as parquet
pandas = "*"
pyarrow = "*"

[dev-packages]

[requires]
python_version = "3.11"
